{
  "name": "lasso",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source reporting for AI tooling usage, cost, limits, and behaviour across Cursor and Claude.",
  "license": "Apache-2.0",
  "repository": "github:dovetail/lasso",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
