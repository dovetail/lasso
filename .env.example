# Copy to .env and fill in what you have. Every connector is optional.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://lasso:lasso@localhost:55432/lasso
# all = web + background worker in one process (default). Use web/worker to split them.
LASSO_ROLE=all
# Public URL, used for the OIDC redirect (https://lasso.example.com). Inferred from the request if unset.
LASSO_BASE_URL=
# Cron for syncing all connectors (UTC).
LASSO_SYNC_CRON="15 * * * *"
LASSO_BACKFILL_DAYS=90
LASSO_RETENTION_DAYS=400
# Set to 1 to load synthetic demo data into an empty database.
LASSO_DEMO=0

# --- Sign-in ------------------------------------------------------------
# oidc (default) or none (local only: no sign-in at all).
LASSO_AUTH_MODE=oidc
# Long random string used to sign session cookies: openssl rand -base64 48
LASSO_SESSION_SECRET=
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid email profile"
# Optional comma-separated allowlist of email domains, e.g. example.com,example.co.uk
OIDC_ALLOWED_DOMAINS=

# --- Cursor -------------------------------------------------------------
# Cursor dashboard > Settings > Advanced > Admin API keys (Team or Enterprise admin).
CURSOR_API_KEY=

# --- Claude (Enterprise) ------------------------------------------------
# Analytics API key with the read:analytics scope (claude.ai admin settings).
CLAUDE_ANALYTICS_API_KEY=
# Admin API key with read:spend_limits, for per-user spend limits and increase requests.
CLAUDE_ADMIN_API_KEY=
# Claude Team plans: no API. Upload usage CSVs in Settings instead.

# --- GitHub -------------------------------------------------------------
GITHUB_ORG=
# Either a token (classic: read:org, read:user, user:email; fine-grained: org Members read) ...
GITHUB_TOKEN=
# ... or a GitHub App installed on the org with Members: read.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM contents, or base64 of the PEM.
GITHUB_APP_PRIVATE_KEY=
